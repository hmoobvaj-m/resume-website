{
  "name": "portfolio-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/generate-csp.mjs out",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test tests/contact/*.test.mjs tests/csp/*.test.mjs",
    "test:csp": "node --test tests/csp/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "serve:test": "serve out --listen tcp://127.0.0.1:4173"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^24.19.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^10.15.0",
    "eslint-config-next": "16.4.6",
    "miniflare": "5.20261127.0-beta",
    "parse5": "8.1.1",
    "serve": "14.2.8",
    "tailwindcss": "^4.3.5",
    "typescript": "^6"
  }
}